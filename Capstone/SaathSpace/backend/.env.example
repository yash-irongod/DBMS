# SaathSpace Backend Configuration Template
# Duplicate this file to .env and adjust values for your environment

# --- Option 1: Direct Cloud / Remote Database URL (e.g. Neon, Supabase, Render, Railway) ---
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Option 2: Local / Individual Parameters ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saathspace
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# DB_SSLMODE=require  # Uncomment if connecting to a remote database that enforces SSL

# Connection Pool Settings
DB_POOL_MIN=1
DB_POOL_MAX=5

# Application Settings
SECRET_KEY=change_this_to_a_secure_random_key_in_production
FLASK_PORT=5000
FLASK_ENV=development

# Cookie Security (in production with HTTPS set SECURE=true, SAMESITE=None if cross-domain)
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax

# CORS (comma-separated list of origins; supports wildcards like https://*.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app
