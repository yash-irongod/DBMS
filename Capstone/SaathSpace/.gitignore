# ==============================================================================
# SaathSpace .gitignore
# ==============================================================================

# Data protection (keep large raw/processed dumps out of version control)
data/raw/*
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment variables & secrets
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Python runtime & test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Node / Frontend build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE configurations
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS artifacts
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes
